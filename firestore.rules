rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function validCounterId(docId) {
      return docId == "visits"
        || docId.matches("daily_[0-9]{4}-[0-9]{2}-[0-9]{2}");
    }

    function newVisitorMark(docId) {
      return !exists(
          /databases/$(database)/documents/siteStats/$(docId)/visitorMarks/$(request.auth.uid)
        )
        && existsAfter(
          /databases/$(database)/documents/siteStats/$(docId)/visitorMarks/$(request.auth.uid)
        );
    }

    match /siteStats/{docId} {
      // The public counter values are displayed on the website.
      allow read: if true;

      // Total counter schema: { count, updatedAt }.
      // Daily counter schema: { count, date, updatedAt }.
      allow create: if signedIn()
        && validCounterId(docId)
        && request.resource.data.count is int
        && request.resource.data.count == 1
        && request.resource.data.updatedAt == request.time
        && (
          (docId == "visits"
            && request.resource.data.keys().hasOnly(["count", "updatedAt"]))
          ||
          (docId.matches("daily_[0-9]{4}-[0-9]{2}-[0-9]{2}")
            && request.resource.data.keys().hasOnly(["count", "date", "updatedAt"])
            && request.resource.data.date is string)
        )
        && newVisitorMark(docId);

      allow update: if signedIn()
        && validCounterId(docId)
        && resource.data.count is int
        && request.resource.data.count is int
        && request.resource.data.count == resource.data.count + 1
        && request.resource.data.updatedAt == request.time
        && (
          (docId == "visits"
            && resource.data.keys().hasOnly(["count", "updatedAt"])
            && request.resource.data.keys().hasOnly(["count", "updatedAt"]))
          ||
          (docId.matches("daily_[0-9]{4}-[0-9]{2}-[0-9]{2}")
            && resource.data.keys().hasOnly(["count", "date", "updatedAt"])
            && request.resource.data.keys().hasOnly(["count", "date", "updatedAt"])
            && request.resource.data.date is string
            && request.resource.data.date == resource.data.date)
        )
        && newVisitorMark(docId);

      allow delete: if false;
    }

    // One immutable marker per Firebase UID and counter document.
    match /siteStats/{docId}/visitorMarks/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;

      allow create: if signedIn()
        && validCounterId(docId)
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(["createdAt"])
        && request.resource.data.createdAt == request.time;

      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}

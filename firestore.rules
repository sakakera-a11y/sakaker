rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() && request.auth.token.email == 'sakakera@gmail.com';
    }
    function isNotBanned() {
      return signedIn() && !exists(/databases/$(database)/documents/castleForumBans/$(request.auth.uid));
    }
    function validDisplayName(value) {
      return value is string && value.size() > 0 && value.size() <= 80 && !value.matches('.*@.*');
    }
    function validCounterId(docId) {
      return docId == "visits"
        || docId == "sessionVisits"
        || docId.matches("daily_[0-9]{4}-[0-9]{2}-[0-9]{2}")
        || docId.matches("dailySessionVisits_[0-9]{4}-[0-9]{2}-[0-9]{2}");
    }
    function newVisitorMark(docId) {
      return !exists(/databases/$(database)/documents/siteStats/$(docId)/visitorMarks/$(request.auth.uid))
        && existsAfter(/databases/$(database)/documents/siteStats/$(docId)/visitorMarks/$(request.auth.uid));
    }
    function validCreate(docId) {
      return request.resource.data.count is int && request.resource.data.count == 1
        && request.resource.data.updatedAt == request.time
        && (((docId == "visits" || docId == "sessionVisits")
          && request.resource.data.keys().hasOnly(["count", "updatedAt"]))
          || ((docId.matches("daily_[0-9]{4}-[0-9]{2}-[0-9]{2}")
            || docId.matches("dailySessionVisits_[0-9]{4}-[0-9]{2}-[0-9]{2}"))
            && request.resource.data.keys().hasOnly(["count", "date", "updatedAt"])
            && request.resource.data.date is string));
    }
    function validUpdate(docId) {
      return resource.data.count is int && request.resource.data.count is int
        && request.resource.data.count == resource.data.count + 1
        && request.resource.data.updatedAt == request.time
        && (((docId == "visits" || docId == "sessionVisits")
          && resource.data.keys().hasOnly(["count", "updatedAt"])
          && request.resource.data.keys().hasOnly(["count", "updatedAt"]))
          || ((docId.matches("daily_[0-9]{4}-[0-9]{2}-[0-9]{2}")
            || docId.matches("dailySessionVisits_[0-9]{4}-[0-9]{2}-[0-9]{2}"))
            && resource.data.keys().hasOnly(["count", "date", "updatedAt"])
            && request.resource.data.keys().hasOnly(["count", "date", "updatedAt"])
            && request.resource.data.date is string
            && request.resource.data.date == resource.data.date));
    }

    // Existing site counters remain unchanged.
    match /siteStats/{docId} {
      allow read: if true;
      allow create: if signedIn() && validCounterId(docId) && validCreate(docId) && newVisitorMark(docId);
      allow update: if signedIn() && validCounterId(docId) && validUpdate(docId) && newVisitorMark(docId);
      allow delete: if false;
    }
    match /siteStats/{docId}/visitorMarks/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn() && validCounterId(docId) && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(["createdAt"])
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    // Castle Forum: public read, immediate member publishing, moderator-only control.
    match /castleForumPosts/{postId} {
      allow read: if true;
      allow create: if isNotBanned()
        && request.resource.data.keys().hasOnly(["authorUid", "authorName", "title", "body", "category", "createdAt"])
        && request.resource.data.authorUid == request.auth.uid
        && validDisplayName(request.resource.data.authorName)
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 100
        && request.resource.data.body is string
        && request.resource.data.body.size() > 0
        && request.resource.data.body.size() <= 6000
        && request.resource.data.category in ["story", "poetry", "opinion", "suggestion"]
        && request.resource.data.createdAt == request.time;
      allow update: if false;
      allow delete: if isAdmin();
    }
    match /castleForumProfiles/{uid} {
      allow read: if true;
      allow create: if isNotBanned() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(["uid", "name", "createdAt"])
        && request.resource.data.uid == uid
        && validDisplayName(request.resource.data.name)
        && request.resource.data.createdAt == request.time;
      allow update: if false;
      allow delete: if isAdmin();
    }
    match /castleForumProfilePosts/{postId} {
      allow read: if true;
      allow create: if isNotBanned()
        && request.resource.data.keys().hasOnly(["profileUid", "authorUid", "authorName", "title", "body", "category", "createdAt"])
        && request.resource.data.profileUid == request.auth.uid
        && request.resource.data.authorUid == request.auth.uid
        && exists(/databases/$(database)/documents/castleForumProfiles/$(request.auth.uid))
        && validDisplayName(request.resource.data.authorName)
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 100
        && request.resource.data.body is string
        && request.resource.data.body.size() > 0
        && request.resource.data.body.size() <= 6000
        && request.resource.data.category in ["story", "poetry", "opinion", "suggestion"]
        && request.resource.data.createdAt == request.time;
      allow update: if false;
      allow delete: if isAdmin();
    }
    match /castleForumReplies/{replyId} {
      allow read: if true;
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(["postId", "postType", "postTitle", "text", "authorName", "createdAt"])
        && request.resource.data.postId is string
        && request.resource.data.postType in ["public", "profile"]
        && ((request.resource.data.postType == "public"
            && exists(/databases/$(database)/documents/castleForumPosts/$(request.resource.data.postId)))
          || (request.resource.data.postType == "profile"
            && exists(/databases/$(database)/documents/castleForumProfilePosts/$(request.resource.data.postId))))
        && request.resource.data.postTitle is string
        && request.resource.data.postTitle.size() <= 100
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 2000
        && request.resource.data.authorName == 'إدارة المنتدى'
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }
    match /castleForumReports/{reportId} {
      allow read: if isAdmin();
      allow create: if isNotBanned()
        && request.resource.data.keys().hasOnly(["reporterUid", "reporterName", "type", "title", "details", "pagePath", "reference", "createdAt"])
        && request.resource.data.reporterUid == request.auth.uid
        && validDisplayName(request.resource.data.reporterName)
        && request.resource.data.type in ["inappropriate", "suggestion", "technical", "other"]
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 100
        && request.resource.data.details is string
        && request.resource.data.details.size() > 0
        && request.resource.data.details.size() <= 3000
        && request.resource.data.pagePath is string
        && request.resource.data.pagePath.size() <= 200
        && request.resource.data.reference is string
        && request.resource.data.reference.size() <= 300
        && request.resource.data.createdAt == request.time;
      allow update: if false;
      allow delete: if isAdmin();
    }
    match /castleForumBans/{uid} {
      allow get: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow list: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(["uid", "createdAt"])
        && request.resource.data.uid == uid
        && request.resource.data.createdAt == request.time;
      allow update: if false;
      allow delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}

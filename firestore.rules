rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function validCounterId(docId) {
      return docId == "visits"
        || docId == "sessionVisits"
        || docId.matches("daily_[0-9]{4}-[0-9]{2}-[0-9]{2}")
        || docId.matches("dailySessionVisits_[0-9]{4}-[0-9]{2}-[0-9]{2}");
    }

    function newVisitorMark(docId) {
      return !exists(
          /databases/$(database)/documents/siteStats/$(docId)/visitorMarks/$(request.auth.uid)
        )
        && existsAfter(
          /databases/$(database)/documents/siteStats/$(docId)/visitorMarks/$(request.auth.uid)
        );
    }

    function validCreate(docId) {
      return request.resource.data.count is int
        && request.resource.data.count == 1
        && request.resource.data.updatedAt == request.time
        && (
          ((docId == "visits" || docId == "sessionVisits")
            && request.resource.data.keys().hasOnly(["count", "updatedAt"]))
          ||
          ((docId.matches("daily_[0-9]{4}-[0-9]{2}-[0-9]{2}")
              || docId.matches("dailySessionVisits_[0-9]{4}-[0-9]{2}-[0-9]{2}"))
            && request.resource.data.keys().hasOnly(["count", "date", "updatedAt"])
            && request.resource.data.date is string)
        );
    }

    function validUpdate(docId) {
      return resource.data.count is int
        && request.resource.data.count is int
        && request.resource.data.count == resource.data.count + 1
        && request.resource.data.updatedAt == request.time
        && (
          ((docId == "visits" || docId == "sessionVisits")
            && resource.data.keys().hasOnly(["count", "updatedAt"])
            && request.resource.data.keys().hasOnly(["count", "updatedAt"]))
          ||
          ((docId.matches("daily_[0-9]{4}-[0-9]{2}-[0-9]{2}")
              || docId.matches("dailySessionVisits_[0-9]{4}-[0-9]{2}-[0-9]{2}"))
            && resource.data.keys().hasOnly(["count", "date", "updatedAt"])
            && request.resource.data.keys().hasOnly(["count", "date", "updatedAt"])
            && request.resource.data.date is string
            && request.resource.data.date == resource.data.date)
        );
    }

    match /siteStats/{docId} {
      // The published website displays only the numeric counter documents.
      allow read: if true;

      // All writes are a single +1 with one immutable per-UID/session marker.
      allow create: if signedIn()
        && validCounterId(docId)
        && validCreate(docId)
        && newVisitorMark(docId);

      allow update: if signedIn()
        && validCounterId(docId)
        && validUpdate(docId)
        && newVisitorMark(docId);

      allow delete: if false;
    }

    match /siteStats/{docId}/visitorMarks/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;

      allow create: if signedIn()
        && validCounterId(docId)
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(["createdAt"])
        && request.resource.data.createdAt == request.time;

      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
